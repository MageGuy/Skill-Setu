# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas — matches the pattern used in your other projects)
MONGO_URI=mongodb://127.0.0.1:27017/skillsetu

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
COOKIE_NAME=skillsetu_token

# CORS — the Vite dev server for Frontend/
FRONTEND_URL=http://localhost:5173

# OTP (dev stub — no real SMS/email gateway wired up yet, see README)
OTP_EXPIRY_MINUTES=10
OTP_DEBUG_ECHO=true

# Uploads
UPLOAD_MAX_MB=10

# Dossier signing (falls back to JWT_SECRET if unset)
DOSSIER_SIGNING_SECRET=change_this_too

# ─── Quarterly Employment Check-in Emails ───────────────────────────────────
# Set to "true" to auto-schedule the check-in cycle (1st of Jan/May/Sep at 09:00)
CHECK_IN_CRON_ENABLED=false

# SMTP for real email delivery. If unset, emails are logged to the console.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#   SMTP_PASS=<app-specific password from Google Account settings>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Skill-Setu Portal <noreply@skillsetu.gov.in>

# ─── Google OAuth (for "Login with Google" button) ─────────────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client IDs. Set the authorized redirect URI to:
#   http://localhost:5000/api/auth/google/callback  (dev)
#   https://api.yourdomain.com/api/auth/google/callback  (prod)
# If unset, the /api/auth/google endpoint returns a 501 with instructions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini API key (for AI features — training analysis, job discovery, tech trends)
# Get a FREE key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the default Gemini model (defaults to gemini-1.5-flash)
# Other options: gemini-1.5-pro, gemini-2.0-flash-exp, gemini-2.5-flash
GEMINI_MODEL=
